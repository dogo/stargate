#!/bin/sh
# opencode adapter for stargate. Verified against opencode 1.18.31.
# Callers must supply --format json (as both shipped agent commands do).
#
# Five things this works around:
#  1. opencode writes NOTHING when its stdout is a regular file, and that is
#     exactly what stargate hands a command: run_process() passes an open trace
#     file as stdout with stderr merged into it (core.py). Piping it -- which
#     this script does by construction -- is what makes it emit anything at all,
#     independently of the output format.
#  2. The JSON event stream contains tool events as well as assistant text.
#     Text following a tool replaces interim narration, with the last value
#     of each part; a trailing tool preserves the latest assistant response.
#  3. Auth uses the AI SDK variable names: GOOGLE_GENERATIVE_AI_API_KEY, not
#     GEMINI_API_KEY. This maps one to the other when only the latter is set.
#  4. POSIX sh reports only the last pipeline command's status. A FIFO lets
#     opencode write into a pipe while wait preserves its failure for retries.
#  5. Every exit path must stop and reap the background opencode request so it
#     cannot keep running and billing after the wrapper exits.
set -e
out=$1; shift

if [ -z "${GOOGLE_GENERATIVE_AI_API_KEY:-}" ] && [ -n "${GEMINI_API_KEY:-}" ]; then
  GOOGLE_GENERATIVE_AI_API_KEY="$GEMINI_API_KEY"
  export GOOGLE_GENERATIVE_AI_API_KEY
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/opencode-stargate.XXXXXX")
pid=
# Keep opencode in our group: set -m would put it outside run_process()'s
# SIGKILL sweep, which no trap can catch. When we lead the group (stargate's
# start_new_session case), TERM reaches Bun's children too. Otherwise only
# signal our child: signalling the inherited group would hit our caller.
cleanup() {
  trap '' INT TERM HUP
  if [ -n "$pid" ]; then
    if kill -0 "-$$" 2>/dev/null; then
      kill -TERM "-$$" 2>/dev/null || :
    else
      kill -TERM "$pid" 2>/dev/null || :
    fi
    # Bound the wait even if opencode ignores TERM.
    kill -KILL "$pid" 2>/dev/null || :
    wait "$pid" 2>/dev/null || :
    pid=
  fi
  rm -rf "$tmp" || :
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
mkfifo "$tmp/trace"

# Prevent colour inside JSON text values; the reader does not strip it.
NO_COLOR=1 opencode run "$@" </dev/null >"$tmp/trace" 2>&1 &
pid=$!

# python3, not jq: stargate requires Python, so the user already has that
# dependency; jq is not guaranteed to be installed.
# Background the filter so wait can run signal traps immediately; a foreground
# pipeline would defer cleanup until the very request we must stop finishes.
python3 -u -c '
import json
import sys

# JSON is UTF-8 regardless of the locale. Decode inside the guard so stray
# tool diagnostic bytes cannot stop the drain and give opencode SIGPIPE.
sys.stdout.reconfigure(encoding="utf-8", errors="backslashreplace")
sys.stderr.reconfigure(encoding="utf-8", errors="backslashreplace")
parts = {}
tool_seen = False
missing_id = object()
for raw_line in sys.stdin.buffer:
    try:
        line = raw_line.decode("utf-8")
        event = json.loads(line)
    except (ValueError, RecursionError):
        sys.stderr.write(raw_line.decode("utf-8", errors="backslashreplace"))
        continue
    if not isinstance(event, dict):
        sys.stderr.write(line)
        continue
    part = event.get("part")
    # Replace interim narration only when a subsequent response arrives:
    # a trailing tool must not discard the only assistant answer we have.
    if event.get("type") == "tool_use" or (
        isinstance(part, dict) and part.get("type") == "tool"
    ):
        tool_seen = True
        continue
    if not isinstance(part, dict) or part.get("type") != "text":
        continue
    if not isinstance(part.get("text"), str):
        continue
    if tool_seen:
        parts.clear()
        tool_seen = False
    part_id = part.get("id")
    if not isinstance(part_id, str):
        # Without usable IDs, treat text as one growing part to avoid duplication.
        part_id = missing_id
    # Replacing a growing part preserves its first-appearance order.
    parts[part_id] = part["text"]

# Drain the FIFO before opening the answer: a write failure must not cause
# SIGPIPE in opencode and hide its own failure status.
answer = "".join(parts.values()).rstrip()
if answer:
    answer += "\n"
with open(sys.argv[1], "w", encoding="utf-8") as output:
    output.write(answer)
sys.stdout.write(answer)
' "$out" <"$tmp/trace" &
filter=$!
filter_status=0
wait "$filter" 2>/dev/null || filter_status=$?

status=0
wait "$pid" || status=$?
# Reaped: the kernel may reuse its PID, so cleanup must no longer signal it.
pid=
# A successful request still failed if the reader could not write the answer.
if [ "$status" -eq 0 ]; then
  status=$filter_status
fi
exit "$status"
